---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('caseStudies', (e) => !e.data.draft);
const byIndustry = new Map<string, typeof all>();
for (const c of all) {
  const list = byIndustry.get(c.data.industry) ?? [];
  list.push(c);
  byIndustry.set(c.data.industry, list);
}
const industries = [...byIndustry.keys()].sort();
---
<Base title="Case Studies" description="Selected SEO and digital product case studies by industry.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>Case Studies</h1>
      {industries.map((industry) => (
        <div class="group">
          <h2>{industry}</h2>
          <div class="grid">
            {byIndustry.get(industry)!.map((c) => (
              <Card href={`/case-studies/${c.id}/`} title={c.data.title} meta={c.data.client} summary={c.data.summary} tags={c.data.disciplines} />
            ))}
          </div>
        </div>
      ))}
      {all.length === 0 && <p>No case studies published yet.</p>}
    </div>
  </section>
</Base>
<style>.group { margin-top: 2.5rem; }</style>
